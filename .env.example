RELAYGUARD_REQUEST_MAX_INPUT_CHARS=12000
RELAYGUARD_REQUEST_LIMIT_PER_MINUTE=60
RELAYGUARD_DEFAULT_TENANT_BUDGET_USD=0.05
RELAYGUARD_PROVIDER_TIMEOUT_SECONDS=8
RELAYGUARD_PROVIDER_RETRY_ATTEMPTS=2
RELAYGUARD_CIRCUIT_BREAKER_FAILURE_THRESHOLD=2
RELAYGUARD_CIRCUIT_BREAKER_RESET_SECONDS=30
RELAYGUARD_AUTH_MODE=api_key
# Demo-only mapping. Replace with rotated secrets supplied by a secrets manager.
RELAYGUARD_TENANT_API_KEYS={"demo-acme-viewer-key":{"tenant_id":"acme","role":"viewer"},"demo-acme-operator-key":{"tenant_id":"acme","role":"operator"}}
# Keep mock mode for safe local demos. Switch to openai only after setting a server-side key.
RELAYGUARD_PROVIDER_MODE=mock
# RELAYGUARD_OPENAI_API_KEY=sk-...
